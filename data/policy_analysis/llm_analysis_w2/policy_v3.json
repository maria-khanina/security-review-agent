      "quote": "Admin and debug endpoints MUST NOT be exposed to the public internet.",
      "span": [
        804,
        873
      ],
      "wording": "clear",
      "topics": [
        "network",
        "operations"
      ]
    },
    {
      "id": "R8",
      "quote": "For long-lived sessions, an access token lifetime of up to 30 minutes is acceptable.",
      "span": [
        876,
        960
      ],
      "wording": "vague",
      "topics": [
        "authentication",
        "operations"
      ]
    },
    {
