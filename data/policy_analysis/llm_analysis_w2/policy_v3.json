{
  "policy_version": "v3",
  "requirements": [
    {
      "id": "R1",
      "quote": "Public endpoints MUST require OAuth2/OIDC bearer tokens or mutual TLS.",
      "span": [
        329,
        399
      ],
      "wording": "clear",
      "topics": [
        "authentication",
        "network"
      ]
    },
    {
      "id": "R2",
      "quote": "Services SHOULD authenticate each other with mutual TLS or workload identity tokens.",
      "span": [
        402,
        486
      ],
      "wording": "vague",
      "topics": [
        "authentication",
        "network"
      ]
    },
    {
      "id": "R3",
      "quote": "Access tokens MUST expire within 15 minutes. Refresh tokens MUST be rotated on use.",
      "span": [
        489,
        572
      ],
      "wording": "clear",
      "topics": [
        "authentication",
        "operations"
      ]
    },
    {
